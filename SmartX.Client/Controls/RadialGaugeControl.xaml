<UserControl x:Class="SmartX.Client.Controls.RadialGaugeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="140" Height="140">
    <Grid>
        <Ellipse Stroke="#334155" StrokeThickness="14" Width="120" Height="120"/>
        <Path x:Name="ArcPath" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Width="120" Height="120"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="ScoreText" FontSize="30" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" Text="100"/>
            <TextBlock Text="score" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
