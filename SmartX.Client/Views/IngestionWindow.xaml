<Window x:Class="SmartX.Client.Views.IngestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SmartX.Client.Controls"
        xmlns:converters="clr-namespace:SmartX.Client.Converters"
        Title="Smart-X - Sensor Data Ingestion and Telemetry"
        Height="740" Width="1200" WindowStartupLocation="CenterScreen" Background="#0F172A">

    <Window.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter"/>

        <DataTemplate x:Key="SensorCardTemplate">
            <Border Width="220" Margin="8" Padding="16" CornerRadius="14" Background="#1E293B"
                    BorderThickness="2" BorderBrush="{Binding StateColor, Converter={StaticResource HexToBrushConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding Location}" FontSize="14" FontWeight="Bold" Foreground="White"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding MacAddress}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,10"/>

                    <controls:RadialGaugeControl Score="{Binding Score}" HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding StreakText}" FontSize="12" Foreground="#F59E0B" FontWeight="Bold"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,6"/>

                    <Border Background="{Binding StateColor, Converter={StaticResource HexToBrushConverter}}"
                            Opacity="0.18" CornerRadius="6" Padding="6,4">
                        <TextBlock Text="{Binding StateBadgeText}" FontSize="11" FontWeight="Bold"
                                   Foreground="{Binding StateColor, Converter={StaticResource HexToBrushConverter}}"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left column: registration, actions, log -->
        <ScrollViewer Grid.Column="0" Margin="0,0,20,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Button x:Name="BackButton" Content="&#8592; Back to menu" HorizontalAlignment="Left"
                        Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Padding="0"
                        Margin="0,0,0,20" Click="BackButton_Click" Cursor="Hand"/>

                <TextBlock Text="Register Sensor" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

                <TextBlock Text="MAC Address / Unique Identifier" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,2"/>
                <TextBox x:Name="MacTextBox" Margin="0,0,0,10" Padding="6" Text="24:6F:28:AE:11:9C"/>

                <TextBlock Text="Deployment Location (Room / Zone / Node)" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,2"/>
                <TextBox x:Name="LocationTextBox" Margin="0,0,0,10" Padding="6" Text="Sub-Zone B / Zone 1 / Facility A"/>

                <TextBlock Text="Sensor Category" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,2"/>
                <ComboBox x:Name="CategoryCombo" Margin="0,0,0,14" Padding="6"/>

                <Button x:Name="RegisterButton" Content="Register Sensor" Padding="8" Background="#2563EB"
                        Foreground="White" BorderThickness="0" Click="RegisterButton_Click" Cursor="Hand"
                        Margin="0,0,0,26"/>

                <TextBlock Text="Act on Sensor" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

                <TextBlock Text="Target sensor" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,2"/>
                <ComboBox x:Name="TargetSensorCombo" Margin="0,0,0,14" Padding="6"/>

                <Button x:Name="AttachFileButton" Content="Attach Config File / Photo / Log..." Padding="8"
                        Background="#334155" Foreground="White" BorderThickness="0" Click="AttachFileButton_Click"
                        Cursor="Hand" Margin="0,0,0,8"/>

                <Button x:Name="SendReadingButton" Content="Send One Live Reading" Padding="8"
                        Background="#334155" Foreground="White" BorderThickness="0" Click="SendReadingButton_Click"
                        Cursor="Hand" Margin="0,0,0,8"/>

                <Button x:Name="SeedButton" Content="Stress-Test: Seed 10,000 Readings" Padding="8"
                        Background="#7C3AED" Foreground="White" BorderThickness="0" Click="SeedButton_Click"
                        Cursor="Hand" Margin="0,0,0,26"/>

                <TextBlock Text="Activity Log" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                <ListBox x:Name="LogListBox" Height="220" Background="#1E293B" Foreground="#CBD5E1"
                         BorderThickness="0" FontSize="11"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Right column: live engagement widgets -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Live Sensor Health" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                <TextBlock Text="Health Score + Streak cards update automatically from the ingestion gateway."
                           FontSize="12" Foreground="#94A3B8" Margin="0,0,0,16"/>

                <ItemsControl x:Name="SensorItemsControl" ItemTemplate="{StaticResource SensorCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
