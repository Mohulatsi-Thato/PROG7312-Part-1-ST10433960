<Application x:Class="SmartX.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ===== Brand palette — pushed for real contrast ===== -->
            <SolidColorBrush x:Key="BrandDark"  Color="#0B0E17"/>
            <SolidColorBrush x:Key="BrandGrey"  Color="#7A8699"/>
            <SolidColorBrush x:Key="BrandLight" Color="#EEF1FA"/>
            <SolidColorBrush x:Key="BrandGreen" Color="#00D68F"/>
            <SolidColorBrush x:Key="BrandAmber" Color="#FFB238"/>
            <SolidColorBrush x:Key="BrandRed"   Color="#FF4D6D"/>
            <SolidColorBrush x:Key="BrandBlue"  Color="#5B47FB"/>

            <SolidColorBrush x:Key="BrandCard"   Color="#FFFFFF"/>
            <SolidColorBrush x:Key="BrandBorder" Color="#DDE1EC"/>

            <LinearGradientBrush x:Key="BrandAccentGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#5B47FB" Offset="0"/>
                <GradientStop Color="#00C2FF" Offset="1"/>
            </LinearGradientBrush>

            <!-- ===== Fonts ===== -->
            <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="AppFontDisplay">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>

            <DropShadowEffect x:Key="CardShadow"
                               Color="#1E293B" Opacity="0.12"
                               BlurRadius="24" ShadowDepth="4" Direction="270"/>

            <!-- ===== Base implicit styles ===== -->
            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource BrandLight}"/>
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="TextElement.Foreground" Value="{StaticResource BrandDark}"/>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="Foreground" Value="{StaticResource BrandDark}"/>
            </Style>

            <!-- Explicit — apply to page/section titles -->
            <Style x:Key="HeaderText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontDisplay}"/>
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource BrandDark}"/>
            </Style>

            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="Foreground" Value="{StaticResource BrandGrey}"/>
            </Style>

            <!-- Default button: solid brand blue, pill-ish radius -->
            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrandBlue}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="18,11"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#4536D6"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandBorder}"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrandGrey}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Explicit — the hero / primary CTA, uses the gradient -->
            <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{StaticResource BrandAccentGradient}"/>
                <Setter Property="Padding" Value="24,14"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="24"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource BrandCard}"/>
                <Setter Property="Foreground" Value="{StaticResource BrandDark}"/>
                <Setter Property="CaretBrush" Value="{StaticResource BrandBlue}"/>
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrandBorder}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="Padding" Value="12,9"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Explicit — landing tiles / health cards, now with shadow + accent strip -->
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BrandCard}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrandBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="22"/>
                <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>